{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "automerge": true,
  "extends": [
    "config:base"
  ],
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["com.puppycrawl.tools:checkstyle"],
      "allowedVersions": "<14.4"
    },
    {
      "matchManagers": ["maven"],
      "matchPackageNames": ["net.sf.saxon:Saxon-HE"],
      "allowedVersions": "<13"
    }
  ]
}
