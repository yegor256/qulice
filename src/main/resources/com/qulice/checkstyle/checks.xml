    <!--
    Demand unnamed variables ('_'), a Java 22 feature, while Qulice
    still targets Java 21.
    -->
    <module name="UnusedCatchParameterShouldBeUnnamed">
      <property name="severity" value="ignore"/>
    </module>
    <module name="UnusedLambdaParameterShouldBeUnnamed">
      <property name="severity" value="ignore"/>
    </module>
    <module name="UnusedTryResourceShouldBeUnnamed">
      <property name="severity" value="ignore"/>
    </module>
    <!--
    Demands that an annotation share a line with its target, which is the
    opposite of what 'AnnotationLocation' above demands. No arrangement
    satisfies both, and Checkstyle itself calls the check "not good
    practice".
    -->
    <module name="AnnotationOnSameLine">
      <property name="severity" value="ignore"/>
    </module>
    <!--
    Demands an empty Javadoc line before the at-clauses in every case, while
    our 'JavadocEmptyLineBeforeTagCheck' asks for one only when the body
    spans more than a single paragraph, and forbids it otherwise. Inserting
    the line to satisfy this module makes that one report 621 violations.
    -->
    <module name="RequireEmptyLineBeforeBlockTagGroup">
      <property name="severity" value="ignore"/>
    </module>
    <!--
    Two rules in one. The first wants a blank line after the opening brace
    of a type body, which our 'EmptyLineBeforeFirstMemberCheck' already
    demands, so enabling it would report every such mistake twice. The
    second wants a blank line before the closing brace, which this
    codebase does not do in 196 places.
    -->
    <module name="TypeBodyPadding">
      <property name="severity" value="ignore"/>
    </module>
    <!--
    Reject shapes that ordinary Java needs: a 'main' method, an
    abstract class named after its role, a class without a constructor.
    -->
    <module name="AbstractClassName">
      <property name="severity" value="ignore"/>
    </module>
    <module name="MissingCtor">
      <property name="severity" value="ignore"/>
    </module>
    <module name="UncommentedMain">
